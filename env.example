# ─────────────────────────────────────────────────────────────
# GEM Outbound — variabili d'ambiente
# Copia questo file in .env.local e compila i valori.
# In produzione vanno impostate nel pannello Vercel.
# ─────────────────────────────────────────────────────────────

# JWT_SECRET (OBBLIGATORIA): segreto per firmare i token di sessione.
# In produzione l'avvio FALLISCE se manca. Genera con: openssl rand -hex 32
JWT_SECRET=""

# DATABASE_URL (OBBLIGATORIA): connection string Neon Postgres.
# Persiste esiti chiamate, follow-up, contatti e access log.
DATABASE_URL=""

# WILDIX_WEBHOOK_SECRET (OBBLIGATORIA): segreto condiviso con Wildix per
# verificare la firma HMAC-SHA256 del webhook (esiti/trascrizioni/riassunti).
WILDIX_WEBHOOK_SECRET=""

# GITHUB_TOKEN (OBBLIGATORIA in produzione): Personal Access Token con
# permesso di scrittura sul repo, usato per leggere/scrivere users.json e
# voicebots.json. Senza, il backend usa un fallback su file locale (solo dev).
GITHUB_TOKEN=""

# APP_URL: URL pubblico dell'app (link auto-referenziali).
APP_URL=""

# ── SMTP: invio email (notifiche follow-up, fine campagna, ticket supporto) ──
# Senza queste, le funzionalità email restano disattivate.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# SMTP_SECURE: "true" solo se usi la porta 465 (TLS implicito).
SMTP_SECURE="false"

# NOTIFY_EMAIL: destinatario delle notifiche automatiche (follow-up e
# completamento campagna).
NOTIFY_EMAIL=""

# ── Lancio campagne (inoltro a Make dal server) ──
# URL dei webhook Make (OBBLIGATORI per le chiamate reali: nel codice non ci
# sono più URL di riserva).
# Dopo il passaggio in produzione è consigliato RIGENERARLI in Make (i vecchi
# erano visibili nel browser) e impostare qui i nuovi.
MAKE_WEBHOOK_URL=""
MAKE_WEBHOOK_URL_APPUNTAMENTI=""
# Segreto inviato a Make nell'header "x-gem-secret": in Make aggiungi un
# filtro che accetta solo richieste con questo valore.
MAKE_WEBHOOK_SECRET=""

# CALLS_DRY_RUN: "true" = lancio SIMULATO, nessuna chiamata reale.
# Se vuota: chiamate reali solo in produzione Vercel (VERCEL_ENV=production),
# simulate in anteprima/test e in locale. "false" forza le chiamate reali.
CALLS_DRY_RUN=""

# GITHUB_DATA_BRANCH: branch da cui leggere/scrivere users.json e
# voicebots.json. Vuota = branch principale (produzione).
# Negli ambienti di test usa un branch dedicato (es. "test-data"): senza,
# nelle anteprime Vercel le scritture vengono bloccate.
GITHUB_DATA_BRANCH=""

# ── API Wildix (tracce voicebot: stato, uso e costo per sessione) ──
# Token API con scope di lettura sui voicebot. Senza, la sezione resta vuota.
WILDIX_API_TOKEN=""
# Indirizzo base delle API. Vuota = https://gem.wildixin.com
WILDIX_API_URL=""
